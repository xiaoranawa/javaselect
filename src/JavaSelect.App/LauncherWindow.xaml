<Window x:Class="JavaSelect.App.LauncherWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="using:JavaSelect.App.UI" Title="JavaSelect Launcher">
 <Grid x:Name="Root" Background="Transparent" PreviewKeyDown="Root_PreviewKeyDown">
  <Border x:Name="BackdropLayer" CornerRadius="10"><Image x:Name="BackgroundImage" Stretch="UniformToFill" IsHitTestVisible="False" /></Border>
  <ui:AmbientGlow x:Name="Glow" />
  <Border x:Name="SurfaceFrame" CornerRadius="10" BorderThickness="1">
   <Grid x:Name="Inner" Padding="18" RowSpacing="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><Border x:Name="HeadingPlate" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="6" Padding="7,3" Margin="-7,-3"><TextBlock x:Name="Heading" Text="切换 Java" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></Border><Border x:Name="ShortcutPlate" HorizontalAlignment="Right" CornerRadius="5" Padding="7,3" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><TextBlock Text="Alt + J" x:Name="ShortcutLabel" FontSize="11" Opacity="0.65"/></Border></Grid>
    <ListView x:Name="Versions" Grid.Row="1" SelectionMode="Single" SingleSelectionFollowsFocus="False" IsItemClickEnabled="True" ItemClick="Versions_ItemClick" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
     <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="MinHeight" Value="56"/><Setter Property="CornerRadius" Value="10"/><Setter Property="UseSystemFocusVisuals" Value="False"/></Style></ListView.ItemContainerStyle>
    </ListView>
    <Grid Grid.Row="2" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border x:Name="HintPlate" HorizontalAlignment="Left" CornerRadius="5" Padding="6,3" Margin="-6,-3"><TextBlock x:Name="Hint" Text="↑ ↓ 选择 · Enter 确认" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis"/></Border><Border x:Name="EscapePlate" Grid.Column="1" CornerRadius="5" Padding="6,3" Margin="-6,-3"><TextBlock x:Name="EscapeHint" Text="Esc 关闭" FontSize="11" Opacity="0.65"/></Border></Grid>
   </Grid>
  </Border>
 </Grid>
</Window>
