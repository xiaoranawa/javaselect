<Window
    x:Class="JavaSelect.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:JavaSelect.App.UI"
    Title="JavaSelect">
    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="ContentSurfaceBrush" Color="#AA202127" />
                    <SolidColorBrush x:Key="AboutCardStrokeBrush" Color="#26FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ContentSurfaceBrush" Color="#AA202127" />
                    <SolidColorBrush x:Key="AboutCardStrokeBrush" Color="#26FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ContentSurfaceBrush" Color="#BAFFFFFF" />
                    <SolidColorBrush x:Key="AboutCardStrokeBrush" Color="#1F000000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <DataTemplate x:Key="GitHubIconTemplate"><PathIcon Width="16" Height="16" Data="M6.766 11.328c-2.063-.25-3.516-1.734-3.516-3.656 0-.781.281-1.625.75-2.188-.203-.515-.172-1.609.063-2.062.625-.078 1.468.25 1.968.703.594-.187 1.219-.281 1.985-.281.765 0 1.39.094 1.953.265.484-.437 1.344-.765 1.969-.687.218.422.25 1.515.046 2.047.5.593.766 1.39.766 2.203 0 1.922-1.453 3.375-3.547 3.64.531.344.89 1.094.89 1.954v1.625c0 .468.391.734.86.547C13.781 14.359 16 11.53 16 8.03 16 3.61 12.406 0 7.984 0 3.563 0 0 3.61 0 8.031a7.88 7.88 0 0 0 5.172 7.422c.422.156.828-.125.828-.547v-1.25c-.219.094-.5.156-.75.156-1.031 0-1.64-.562-2.078-1.609-.172-.422-.36-.672-.719-.719-.187-.015-.25-.093-.25-.187 0-.188.313-.328.625-.328.453 0 .844.281 1.25.86.313.452.64.655 1.031.655s.641-.14 1-.5c.266-.265.47-.5.657-.656" /></DataTemplate>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="18" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>
            <Style x:Key="AboutCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
                <Setter Property="Padding" Value="2" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinHeight" Value="272" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{ThemeResource AboutCardStrokeBrush}" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="UseLayoutRounding" Value="True" />
            </Style>
            <Style x:Key="SecondaryText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="SectionText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="2,4,0,0" />
            </Style>
            <Style x:Key="DividerStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="Height" Value="1" />
            </Style>
            <Style x:Key="SettingsRowStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="Padding" Value="18,12" />
                <Setter Property="MinHeight" Value="64" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>
            <DataTemplate x:Key="JavaRowTemplate" x:DataType="ui:JavaRow">
                <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,8,8">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="32" Height="32">
                            <Image Source="{Binding Icon}" Stretch="Uniform" Visibility="{Binding ImageVisibility}" />
                            <FontIcon Glyph="&#xE8F1;" FontSize="24" Visibility="{Binding FallbackVisibility}" />
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="1" Background="{ThemeResource AccentFillColorSecondaryBrush}" CornerRadius="4" Padding="7,2" Visibility="{Binding BadgeVisibility}">
                                    <TextBlock Text="{Binding Badge}" FontSize="11" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource SecondaryText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Path}" Style="{StaticResource SecondaryText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="{Binding SwitchLabel}" Command="{Binding SwitchCommand}" Visibility="{Binding SwitchVisibility}" IsEnabled="{Binding CanSwitch}" MinWidth="70" />
                            <Button Command="{Binding EditCommand}" Visibility="{Binding ManageVisibility}" ToolTipService.ToolTip="{Binding EditLabel}" AutomationProperties.Name="{Binding EditLabel}"><FontIcon Glyph="&#xE70F;" FontSize="15" /></Button>
                            <Button Command="{Binding RemoveCommand}" Visibility="{Binding ManageVisibility}" IsEnabled="{Binding CanRemove}" ToolTipService.ToolTip="{Binding RemoveLabel}" AutomationProperties.Name="{Binding RemoveLabel}"><FontIcon Glyph="&#xE74D;" FontSize="15" /></Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <ui:AmbientGlow x:Name="AmbientLayer" Grid.RowSpan="2" IsHitTestVisible="False" />
        <Grid x:Name="TitleBarArea" Background="Transparent" Padding="18,0,150,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Width="32" Height="32" Source="ms-appx:///Assets/icon.png" />
                <TextBlock Text="JavaSelect" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
        <NavigationView x:Name="Navigation" Grid.Row="1" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
            PaneDisplayMode="Left" OpenPaneLength="206" CompactPaneLength="48" IsPaneToggleButtonVisible="False"
            AlwaysShowHeader="False" Background="Transparent" PaneTitle="" SelectionChanged="NavigationChanged">
            <Border Margin="0,0,12,12" CornerRadius="12" Background="{ThemeResource ContentSurfaceBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid Padding="28,24,20,24" RowSpacing="16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel Spacing="7">
                        <TextBlock x:Name="PageTitle" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock x:Name="PageSubtitle" Style="{StaticResource SecondaryText}" FontSize="13" />
                    </StackPanel>
                    <ScrollViewer x:Name="PageScroll" Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ContentControl x:Name="PageHost" HorizontalContentAlignment="Stretch" Margin="0,0,6,0" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </NavigationView>
        <InfoBar x:Name="StatusBar" Grid.Row="1" IsOpen="False" IsClosable="True" Visibility="Collapsed"
            Severity="Informational" Width="440" HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Margin="24,0,24,24" CornerRadius="8" BorderThickness="1" AutomationProperties.LiveSetting="Polite">
            <InfoBar.RenderTransform><TranslateTransform /></InfoBar.RenderTransform>
            <InfoBar.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Default">
                            <SolidColorBrush x:Key="InfoBarInformationalSeverityBackgroundBrush" Color="#2B2B2B" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Light">
                            <SolidColorBrush x:Key="InfoBarInformationalSeverityBackgroundBrush" Color="#F6F6F6" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="HighContrast">
                            <SolidColorBrush x:Key="InfoBarInformationalSeverityBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </InfoBar.Resources>
        </InfoBar>
    </Grid>
</Window>
